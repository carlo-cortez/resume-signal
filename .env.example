# Server-only Supabase credentials. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# Optional Groq-hosted semantic analysis. Without this server-only key,
# transparent deterministic parsing and scoring remain available.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
