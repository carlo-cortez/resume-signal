# Server-only Supabase credentials. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# Optional semantic analysis. Without this key, transparent deterministic
# parsing and scoring remain available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
